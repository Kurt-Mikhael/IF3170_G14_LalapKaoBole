{
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOCFILE%"
            ],
            "env": {}
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (pdf)",
            "tools": ["latexmk"]
        },
        {
            "name": "pdflatex x2",
            "tools": ["pdflatex", "pdflatex"]
        }
    ],
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.rootFile.indicator": "\\documentclass"
}
